        <mxCell id="eval_header" value="EVALUATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=18;fontFamily=Garamond;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="1280" width="840" height="45" as="geometry" />
        </mxCell>

        <mxCell id="eval_box" value="&lt;div style=&quot;text-align:left;font-family:Garamond;font-size:13px;line-height:1.6;&quot;&gt;&#xa;Analyzing final user acceptance scores and feedback gathered from the following user groups:&lt;br&gt;&lt;br&gt;&#xa;&#xa;• &lt;b&gt;Junior High School Students&lt;/b&gt; — Evaluate usability of the Safe Space portal and Bully Report form through ISO/IEC 25010 questionnaire.&lt;br&gt;&lt;br&gt;&#xa;&#xa;• &lt;b&gt;Guidance Counselors&lt;/b&gt; — Assess functional suitability of the counselor dashboard, accuracy of risk classifications, and timeliness of automated alerts.&lt;br&gt;&lt;br&gt;&#xa;&#xa;• &lt;b&gt;IT / System Administrators&lt;/b&gt; — Evaluate backend performance, API reliability, encryption compliance, and audit log completeness.&lt;br&gt;&lt;br&gt;&#xa;&#xa;• &lt;b&gt;Parents / Guardians&lt;/b&gt; — Rate the clarity, timeliness, and usefulness of SMS and email emergency notifications received.&#xa;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=12;spacingBottom=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="340" y="1325" width="840" height="320" as="geometry" />
        </mxCell>

