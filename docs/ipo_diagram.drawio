        <!-- System Development -->
        <mxCell id="p2t" value="System Development" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontFamily=Garamond;fontStyle=5;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&#xa;• Code frontend and backend using&#xa;  CodeIgniter 4, MySQL, HTML/CSS/JS.&#xa;&#xa;• Build Python API for AI engine.&#xa;&#xa;• Integrate Android SMS Gateway for&#xa;  local text alerts.&#xa;&#xa;• Implement strict AES-256 encryption.&#xa;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Garamond;fontColor=#000000;fillColor=none;strokeColor=none;spacingLeft=8;" vertex="1" parent="1">
