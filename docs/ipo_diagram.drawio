        <!-- Planning -->
        <mxCell id="p1t" value="Planning and defining system objectives" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontFamily=Garamond;fontStyle=5;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="1">
