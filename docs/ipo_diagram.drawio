        <!-- Testing -->
        <mxCell id="p3t" value="Testing and Debugging" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontFamily=Garamond;fontStyle=5;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="630" y="425" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&#xa;• Local testing with Laragon and Python.&#xa;&#xa;• Unit testing and validation of AI tagging&#xa;  accuracy and Multilingual (Tagalog,&#xa;  English, Bisaya, Ilocano) text parsing.&#xa;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Garamond;fontColor=#000000;fillColor=none;strokeColor=none;spacingLeft=8;" vertex="1" parent="1">
