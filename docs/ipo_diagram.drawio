        <!-- Features Title -->
        <mxCell id="o1t" value="Developed and Validated StudentShield&#xa;System with the following features:" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontFamily=Garamond;fontStyle=5;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1070" y="95" width="380" height="45" as="geometry" />
        </mxCell>

        <mxCell id="o1" value="&#xa;• Web-based Safe Space portal with encrypted&#xa;  storage and media attachments.&#xa;&#xa;• Real-time automated text analysis for&#xa;  depression and bullying behavior.&#xa;&#xa;• Immediate automatic SMS emergency alerts&#xa;  directed to parents.&#xa;&#xa;• Real-time Counselor Dashboard offering&#xa;  sorted case prioritizations.&#xa;&#xa;• Automated trend analytics for campus-wide&#xa;  psychological health.&#xa;&#xa;• Conditional Anonymity shielding ensuring&#xa;  user privacy.&#xa;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Garamond;fontColor=#000000;fillColor=none;strokeColor=none;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="140" width="420" height="310" as="geometry" />
        </mxCell>

